<resources>
    <!-- Compose draws the real theme; this keeps the pre-Compose window dark so
         there is no white flash on cold start. -->
    <style name="Theme.NativeAccent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
